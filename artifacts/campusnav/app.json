{
  "expo": {
    "name": "CampusNav",
    "slug": "campusnav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/campusnavlg.png",
    "scheme": "campusnav",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/campusnavlg.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B6B3A"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusNav uses your location to show your position on the campus map and help you navigate to buildings.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CampusNav uses your location to show your position on the campus map and help you navigate to buildings."
      }
    },
    "android": {
      "package": "com.kaethy04.campusnav",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/campusnavlg.png"
    },
    "plugins": [
      [
         "expo-router"
      
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CampusNav uses your location to show your position on the campus map and help you navigate to buildings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d5633396-0f59-4760-bf5f-03d73cccf211"
      }
    }
  }
}
